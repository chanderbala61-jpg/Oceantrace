# OceanTrace Environment Configuration Template
# Copy to .env if customizing local or container paths

# Execution Device: 'auto', 'cpu', or 'cuda'
OCEANTRACE_DEVICE=auto

# Optional overrides for data & checkpoint directories
OCEANTRACE_CHECKPOINT_PATH=outputs/checkpoints/best.pth
OCEANTRACE_IMAGES_DIR=extracted_dataset/images
OCEANTRACE_MASKS_DIR=extracted_dataset/masks
OCEANTRACE_AIS_DATASET_1=outputs/investigations/00955_ais_traffic.csv
OCEANTRACE_AIS_DATASET_2=see thsis/Ocean Trace 2/data/synthetic_ais_demo.csv
OCEANTRACE_OUTPUT_DIR=outputs/investigations

# Streamlit Server Port & Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
