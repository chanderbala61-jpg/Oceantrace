# OceanTrace Git Ignore Policy
# ==============================================================================
# 1. Byte-compiled / Cache / Temporary Files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 2. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 3. Testing & Coverage
.coverage
.coverage.*
.pytest_cache/
htmlcov/
.tox/
.nox/

# 4. Sensitive Credentials & Local Secrets
.env
*.key
*.pem
credentials.json
tokens.json
secrets.yaml

# 5. OS & Local IDE Artifacts
.vscode/
.idea/
Thumbs.db
.DS_Store
desktop.ini
*.log
temp_*/
scratch/

# 6. Large Raw Datasets & Archive Lists (Do NOT commit 40+ GB Sentinel-1 archives)
archive_*.txt
archive_*.csv
missing_*.txt
missing_*.csv
metadata_index.csv
extracted_dataset/images/*
!extracted_dataset/images/00955.tif
!extracted_dataset/images/00594.tif
extracted_dataset/masks/*
!extracted_dataset/masks/00955.tif
!extracted_dataset/masks/00594.tif

# 7. Archives & Legacy External Subfolders
*.zip
*.tar.gz
*.7z
*.rar
Oceantrace_Colab_Exp2/
Oceantrace_Colab_Exp2_UploadParts/
farmproject-main/
oil-spill-detection-main/
temp_audit_samples/
Ocean Trace/
see thsis/*.zip

# 8. Intermediate Training Checkpoints (Keep ONLY validated best.pth)
outputs/checkpoints/chunk_*.pth
outputs/checkpoints/latest.pth
