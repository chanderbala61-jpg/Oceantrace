# OceanTrace Docker Build Ignore Rules
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.coverage
.coverage.*
.pytest_cache/
htmlcov/
.nox/
.tox/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Git & Temporary Files
.git/
.gitignore
temp_*/
*.tmp
*.log

# Sensitive Credentials & Local Overrides
.env
*.key
*.pem
credentials.json
tokens.json

# Large Raw Datasets (Exclude full 40+ GB archive; bundle only demo scenes)
extracted_dataset/images/*
!extracted_dataset/images/00955.tif
!extracted_dataset/images/00594.tif
extracted_dataset/masks/*
!extracted_dataset/masks/00955.tif
!extracted_dataset/masks/00594.tif

# Archives & Upload Parts
*.zip
*.tar.gz
*.7z
*.rar
Oceantrace_Colab_Exp2/
Oceantrace_Colab_Exp2_UploadParts/
farmproject-main/
oil-spill-detection-main/
temp_audit_samples/

# Intermediate Training Checkpoints (Keep only locked best.pth)
outputs/checkpoints/chunk_*.pth
outputs/checkpoints/latest.pth

# OS Artifacts
Thumbs.db
.DS_Store
desktop.ini
